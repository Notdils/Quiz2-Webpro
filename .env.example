# Copy to .env for local development (mvn jetty:run reads it). Production uses real environment variables.
APP_NAME=Harvesta
APP_ENV=local

# PostgreSQL 16+. Use an EMPTY database: tables and demo data are created on first start.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=harvesta_jsp
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Or give a full JDBC URL instead of the four values above (hosted databases):
# DB_URL=jdbc:postgresql://host:5432/dbname?sslmode=require

# Seeded accounts. Passwords default to "password" locally and are REQUIRED in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=
SEED_DEMO_DATA=true
