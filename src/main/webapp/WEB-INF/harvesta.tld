<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>Harvesta formatting and escaping functions (com.harvesta.web.Fn).</description>
    <tlib-version>1.0</tlib-version>
    <short-name>h</short-name>
    <uri>https://harvesta.app/functions</uri>

    <function>
        <name>e</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String e(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>date</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String date(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>number</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String number(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>qty</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String qty(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>integer</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String integer(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>money</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String money(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>label</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String label(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>sel</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String sel(java.lang.Object, java.lang.Object)</function-signature>
    </function>
    <function>
        <name>pageUrl</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String pageUrl(jakarta.servlet.http.HttpServletRequest, int)</function-signature>
    </function>
    <function>
        <name>sortUrl</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String sortUrl(jakarta.servlet.http.HttpServletRequest, java.lang.String)</function-signature>
    </function>
    <function>
        <name>json</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String json(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>due</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String due(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>dueTone</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String dueTone(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>icon</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String icon(java.lang.String)</function-signature>
    </function>
    <function>
        <name>initials</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String initials(java.lang.Object)</function-signature>
    </function>
</taglib>
